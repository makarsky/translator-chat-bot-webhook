# required
TELEGRAM_BOT_TOKEN=<telegram_bot_token>
WEBAPP_URL=https://your-project.vercel.app/api/v1/webhook
TELEGRAM_WEBHOOK_SECRET=<random_url_safe_secret>
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=<turso_auth_token>
PORT=3000

# optional
NGROK_AUTH_TOKEN=<ngrok_auth_token>
NGROK_DOMAIN=<ngrok_domain>
GA4_ENABLED=false
GA4_MEASUREMENT_ID=<measurement_id>
GA4_API_SECRET=<api_secret>
SENTRY_ENABLED=false
SENTRY_PUBLIC_KEY=<key>
SENTRY_PROJECT_ID=<id>
ENVIRONMENT=dev
GIT_TAG=v1.0.0.0
