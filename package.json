{
  "name": "translator-chat-bot-webhook",
  "version": "1.0.0",
  "description": "Translator chat bot webhook",
  "main": "dist/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch index.ts",
    "dev:telegram": "concurrently --kill-others \"npm:dev\" \"tsx scripts/dev-tunnel.ts\"",
    "dev:frontend": "vite --host 0.0.0.0",
    "build": "npm run build:server && npm run build:frontend",
    "build:server": "tsc -p tsconfig.json",
    "build:frontend": "vite build",
    "build:tests": "tsc -p tsconfig.test.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build:server && npm run build:tests && node --test dist/test/*.test.js",
    "lint": "eslint .",
    "lintFix": "eslint . --fix",
    "migrate:turso": "npm run build:server && node dist/scripts/migrate-turso.js",
    "setup:telegram": "npm run build:server && node dist/scripts/setup-telegram.js"
  },
  "author": "Ihar Makarski",
  "license": "MIT",
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@sentry/node": "^11.6.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "google-translate-api-x": "^10.7.3",
    "google-tts-api": "^2.0.2",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ngrok/ngrok": "^1.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "umzug": "^2.3.0",
    "vite": "^8.3.4"
  },
  "overrides": {
    "axios": "^1.20.0"
  }
}
