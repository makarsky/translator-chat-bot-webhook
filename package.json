{
  "name": "translator-chat-bot-webhook",
  "version": "1.0.0",
  "description": "Translator chat bot webhook",
  "main": "index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "dev:telegram": "concurrently --kill-others \"npm:dev\" \"node scripts/dev-tunnel.js\"",
    "dev:frontend": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test",
    "lint": "eslint .",
    "lintFix": "eslint . --fix",
    "migrate:turso": "node scripts/migrate-turso.js",
    "setup:telegram": "node scripts/setup-telegram.js"
  },
  "author": "Igor Makarsky",
  "license": "MIT",
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@sentry/node": "^11.6.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "google-translate-api-x": "^10.7.3",
    "google-tts-api": "^2.0.2",
    "grammy": "^1.46.0",
    "universal-analytics": "^0.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ngrok/ngrok": "^1.7.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "umzug": "^2.3.0",
    "vite": "^8.3.4"
  },
  "overrides": {
    "axios": "^1.20.0"
  }
}
